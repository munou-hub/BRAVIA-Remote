<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/BraviaSection"
        android:text="接続先と認証" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="接続先はこの端末に保存されます。PSKはテレビ側で設定した場合に入力してください。"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/BraviaLabel"
            android:text="テレビのIPアドレス" />

        <EditText
            android:id="@+id/editIp"
            style="@style/BraviaField"
            android:hint="例 192.168.1.20"
            android:inputType="textUri" />

        <TextView
            style="@style/BraviaLabel"
            android:layout_marginTop="12dp"
            android:text="Pre-Shared Key（任意）" />

        <EditText
            android:id="@+id/editPsk"
            style="@style/BraviaField"
            android:hint="テレビ側に設定したPSK"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnSaveConnection"
            style="@style/BraviaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_blue"
            android:text="保存" />

        <Button
            android:id="@+id/btnClearConnection"
            style="@style/BraviaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_panel2"
            android:text="保存先を消去" />
    </LinearLayout>

    <Button
        android:id="@+id/btnBackSettings"
        style="@style/BraviaButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_panel2"
        android:text="設定一覧へ戻る" />
</LinearLayout>

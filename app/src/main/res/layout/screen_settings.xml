<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/BraviaSection"
        android:text="設定" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="設定項目を選んでください。"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/cardConnection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="接続先と認証"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IPアドレス・PSKの確認と変更"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnTestConnection"
        style="@style/BraviaButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_btn_panel2"
        android:text="テレビとの接続を確認" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="4dp"
        android:paddingTop="8dp"
        android:paddingRight="4dp"
        android:paddingBottom="8dp"
        android:text="接続テストの結果がここに表示されます。"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/cardAbout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="アプリ情報"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="バージョン 1.1.0"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnBackRemote"
        style="@style/BraviaButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_blue"
        android:text="リモコンへ戻る" />
</LinearLayout>

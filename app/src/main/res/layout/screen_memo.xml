<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="3dp"
        android:paddingTop="4dp"
        android:paddingRight="3dp"
        android:paddingBottom="14dp"
        android:text="見たい番組の日時を端末に記録します。テレビの録画予約は番組表から設定してください。"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnAddMemo"
        style="@style/BraviaButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_btn_blue"
        android:text="＋  視聴メモを追加" />

    <TextView
        style="@style/BraviaSection"
        android:text="登録したメモ" />

    <LinearLayout
        android:id="@+id/memoList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/memoEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="まだメモはありません。"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
